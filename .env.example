# Salin jadi .env (setup.sh melakukannya otomatis), lalu isi API key lewat halaman Pengaturan.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
WHISPER_LANGUAGE=id
CHUNK_MINUTES=20
SOURCE_MAX_HEIGHT=1080
# Kosongkan agar dicari otomatis (ffmpeg-full dari Homebrew diutamakan)
FFMPEG_BIN=
FFPROBE_BIN=
